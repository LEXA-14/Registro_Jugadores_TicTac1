
@page "/"
@inject PartidasServices partidasServices
@inject JugadoresServicios jugadoresServicios
@inject NavigationManager navigationManager
@inject PartidasApiServices partidaApiServices
@inject MovimientosApiService movimientosApiService
@using Registro_Jugadores_TicTac1.Dto
@using Registro_Jugadores_TicTac1.Models
@using Registro_Jugadores_TicTac1.Services
@rendermode InteractiveServer

<div class="container mx-auto max-w-lg p-10 bg-white rounded-lg shadow-xl text-center" style="background-color: white !important;">
    
    <div class="card-header">
        <div class="card-shadow-lg">
            <h1 class="text-3xl font-bold mb-8 ">Seleccionar Jugadores</h1>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3" role="alert">
                    @errorMessage
                </div>
            }
        </div>

        <div class="card-body mt-8 mb-12">
            <div class="d-flex justify-content-around gap-4">

                @* SELECCION DEL JUGADOR X *@
                <div>
                    <label class="font-semibold text-xl text-danger">Jugador X</label>
                    <InputSelect class="form-select mt-2 bg-red"
                    @bind-Value="partida.Jugador1Id">
                        <option value="0" selected disabled>Seleccione un jugador</option>
                        @foreach (var jugador in ListaJugadores)
                        {
                            <option value="@jugador.JugadorId"
                            disabled="@(jugador.JugadorId == partida.Jugador2Id)">
                                @jugador.Nombres
                            </option>
                        }
                    </InputSelect>
                </div>

                @* SELECCION DEL JUGADOR O*@
                <div>
                    <label class="form-label text-xl text-primary">Jugador O</label>
                    <InputSelect class="form-select mt-2 border-2 border rounded-md focus:ring-blue-500 focus:border-blue-500"
                    @bind-Value="partida.Jugador2Id">
                        <option value="0" selected disabled>Seleccione un jugador</option>
                        @foreach (var jugador in ListaJugadores)
                        {
                            <option value="@jugador.JugadorId"
                            disabled="@(jugador.JugadorId == partida.Jugador1Id)">
                                @jugador.Nombres
                            </option>
                        }
                    </InputSelect>
                </div>
            </div>
        </div>

        <div class="card-footer">
                        @*boton de iniciar Partida*@
            <button class="btn btn-success btn-lg mt-4"
           
            @onclick="IniciarPartida">
                Iniciar Partida
            </button>

          
        </div>

        <div class="card mt-5" style="margin-top: 3rem;">
            <div class="card-header bg-success text-white text-center">
                <h3 class="mb-0">Unirse a Partida Existente</h3>
            </div>
            <div class="card-body" style="padding: 2rem;">
              
                <div class="player-buttons justify-content-center">
                    <div class="mb-3">
                        <label class="form-label">Tu ID de Jugador</label>
                        <input type="number" class="form-control" @bind="MiJugadorId" placeholder="Tu ID" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ID de la Partida:</label>
                        <input type="number" class="form-control" @bind=PartidaId placeholder="ID de la partida" />
                        

                    </div>
            </div>
        </div>
        <div class="card-footer">

                <button class="btn btn-warning btn-lg mt-2"
                        disabled="@(PartidaId == 0 || MiJugadorId == 0)"
                        @onclick="JoinGame">
                    Unirse a Partida
                </button>

        </div>

        </div>
    </div>
</div>


@code {
    private List<Jugadores> ListaJugadores = new List<Jugadores>();
    public Partidas partida = new Partidas();

    private bool ValidoSeleccion => partida.Jugador1Id > 0;


    private Guid CurrentSession { get; set; }
    private static Dictionary<int, Dictionary<Guid, int>> partidaSesiones = new();

    public int Jugador1Id { get; set; }
    public int? Jugador2Id { get; set; }
    public int PartidaId { get; set; }
    public int MiJugadorId { get; set; }

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ListaJugadores = await jugadoresServicios.GetList(j => true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar jugadores: {ex.Message}";
        }
    }

    private async Task IniciarPartida()
    {
        if (!ValidoSeleccion)
        {
            errorMessage = "Debe seleccionar Jugador X";
            return;
        }

        try
        {
            var response = await partidaApiServices.PostPartida(partida.Jugador1Id, partida.Jugador2Id);

            if (response is Resource<PartidasResponse>.Error error)
            {
                errorMessage = $"Error al crear la partida: {error.Message}";
                return;
            }

            PartidaId = response.Data.PartidaId;
            MiJugadorId = partida.Jugador1Id;

            // Navegar al tablero
            navigationManager.NavigateTo($"/JuegoTablero/{PartidaId}/{MiJugadorId}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error al crear la partida: {ex.Message}";
        }
    }

    private async Task JoinGame()
    {
        if (PartidaId <= 0)
        {
            errorMessage = "Debes ingresar el ID de la partida.";
            return;
        }

        if (MiJugadorId <= 0)
        {
            errorMessage = "Debes ingresar tu ID de jugador.";
            return;
        }

        var response = await partidaApiServices.GetPartidaAsync(PartidaId);
        if (response is Resource<PartidasResponse>.Error error)
        {
            errorMessage = $"Error al unirse a la partida: {error.Message}";
            return;
        }

        var partidaData = response.Data;
        if (partidaData == null)
        {
            errorMessage = "No se pudo obtener información de la partida.";
            return;
        }

        Jugador1Id = partidaData.Jugador1Id;
        Jugador2Id = partidaData.Jugador2Id;

        errorMessage = null;

        navigationManager.NavigateTo($"/JuegoTablero/{PartidaId}/{MiJugadorId}");
    }
}