@page "/JuegoTablero/{PartidaId:int}/{MiJugadorId:int}"
@using Registro_Jugadores_TicTac1.Dto
@using Registro_Jugadores_TicTac1.Services

@inject JugadoresServicios jugadoresServicios
@inject PartidasApiServices partidasApiServices
@inject MovimientosApiService movimientosApiService
@inject JuegosServices juegosServices
@inject PartidasApiServices partidaApiServices
@inject MovimientosApiService movimientosApiService
@inject NavigationManager navigationManager

@implements IDisposable
@rendermode InteractiveServer




@*PANTALLA DE JUEGO *@
<div class="game-container">
    <div class="game-screen" style="display: flex; flex-direction: column; justify-content: center; align-items: center;">

        <div style="background-color: #fff3cd; border: 2px solid #ffc107; border-radius: .25rem; padding: 1.5rem 2rem; box-shadow: 0 .125rem .25rem rgba(0,0,0,.075); margin-bottom: 1.5rem;">
            <h5 style="margin: 0; color: #856404; font-weight: 600;">
                🎮 Partida ID: @PartidaId
            </h5>
        </div>
        <div class="d-flex justify-content-center align-items-center mb-4 margin-bottom: 4rem;">






            @* Jugador X box with inline styles *@
            <div style="background-color: #f8f9fa; border: 1px solid #E91E63; border-radius: .25rem; padding: 1rem 1.5rem; box-shadow: 0 .125rem .25rem rgba(0,0,0,.075); margin: 0 .5rem;">
                @if (jugador1 != null)
                {
                    <h6 class="player-x">Jugador X: @jugador1.Nombres</h6>
                }
                else
                {
                    <h5 class="player-x">Jugador X: Cargando...</h5>
                }
            </div>

            @* Jugador O box with inline styles *@
            <div style="background-color: #f8f9fa; border: 1px solid #2196F3; border-radius: .25rem; padding: 1rem 1.5rem; box-shadow: 0 .125rem .25rem rgba(0,0,0,.075); margin: 0 .5rem;">
                @if (jugador2 != null)
                {
                    <h6 class="player-o">Jugador O: @jugador2.Nombres</h6>
                }
                else
                {
                    <h6 class="player-o">Jugador O: Esperando...</h6>
                }
            </div>
        </div>

        <h2 class="game-status">@GameStatus</h2>

        <div class="game-board">
            @for (var i = 0; i < 9; i++)
            {
                var cellIndex = i; // Copia local para evitar problemas con el closure en el lambda
                                   <button class="cell @GetPlayerClass(board[cellIndex])"
                                           @onclick="() => HandleCellClick(cellIndex)"
                                           disabled="@(board[cellIndex] != null || winner != null || esEmpate)">
                                       @board[cellIndex]?.ToString()
                                   </button>
            }
        </div>

        <div class="d-flex justify-content-center mb-3">
            <button class="btn btn-danger mt-4" @onclick="RestartGame">
                Reiniciar Juego
            </button>
            <button class="btn btn-secondary mt-4" @onclick="VolverMenu">
                <span class="bi bi-arrow-left"></span> Volver a Menu
            </button>

        </div>
    </div>

</div>


@code {
    [Parameter] public int PartidaId { get; set; }
    [Parameter] public int MiJugadorId { get; set; }

    private enum PlayerType { X, O }
    private int Jugador1Id { get; set; }
    private int? Jugador2Id { get; set; }

    private PlayerType?[] board = new PlayerType?[9];
    private PlayerType? winner;
    private PlayerType _currentPlayerType = PlayerType.X;
    private bool esEmpate;
    private bool esperandoOponente;
    private bool refreshing = false;
    private string? errorMessage;

    private Jugadores? jugador1;
    private Jugadores? jugador2;
    private Timer? autoRefreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await InicializarJuego();
        StartAutoRefresh();
    }

    private PlayerType Simbolo =>
        MiJugadorId == Jugador1Id ? PlayerType.X : (Jugador2Id.HasValue && MiJugadorId == Jugador2Id ? PlayerType.O : PlayerType.X);

    private async Task InicializarJuego()
    {
        var partidaResponse = await partidasApiServices.GetPartidaAsync(PartidaId);
        if (partidaResponse is Resource<PartidasResponse>.Success success)
        {
            var partida = success.Data!;
            Jugador1Id = partida.Jugador1Id;
            Jugador2Id = partida.Jugador2Id;

            // Verificar acceso del jugador
            if (MiJugadorId != Jugador1Id && (!Jugador2Id.HasValue || MiJugadorId != Jugador2Id.Value))
            {
                if (!Jugador2Id.HasValue || Jugador2Id == 0)
                {
                    var update = await partidasApiServices.PutPartida(PartidaId, Jugador1Id, MiJugadorId);
                    if (update is Resource<PartidasResponse>.Success updateSuccess)
                    {
                        Jugador2Id = updateSuccess.Data!.Jugador2Id;
                    }
                    else if (update is Resource<PartidasResponse>.Error updateError)
                    {
                        errorMessage = $"Error al ingresar el Jugador 2: {updateError.Message}";
                        return;
                    }
                }
                else
                {
                    errorMessage = " No tienes acceso a esta partida. Ya tiene dos jugadores asignados.";
                    return;
                }
            }

            jugador1 = await jugadoresServicios.BuscarId(Jugador1Id);

            if (Jugador2Id.HasValue && Jugador2Id > 0)
            {
                jugador2 = await jugadoresServicios.BuscarId(Jugador2Id.Value);
                esperandoOponente = false;
            }
            else
            {
                esperandoOponente = true;
            }

            await RefreshGameState();
        }
        else if (partidaResponse is Resource<PartidasResponse>.Error error)
        {
            errorMessage = $"Error al cargar la partida: {error.Message}";
        }
    }

    private string GameStatus
    {
        get
        {
            if (winner != null)
            {
                string nombreGanador = winner == PlayerType.X ? jugador1?.Nombres ?? "X" : jugador2?.Nombres ?? "O";
                return winner == Simbolo ? "🏆 ¡Ganaste!" : $" Ganó {nombreGanador}";
            }
            if (esEmpate) return "🤝 ¡Es un empate!";
            if (esperandoOponente) return " Esperando por Jugador O...";

            string nombreTurno = _currentPlayerType == PlayerType.X ? jugador1?.Nombres ?? "X" : jugador2?.Nombres ?? "O";
            return EsMiTurno() ? $" ¡Tu turno! ({_currentPlayerType})" : $" Turno de {nombreTurno} ({_currentPlayerType})";
        }
    }

    private bool EsMiTurno() => _currentPlayerType == Simbolo && !esperandoOponente;

    private bool IsCellDisabled(int index) => board[index] != null || winner != null || esEmpate || !EsMiTurno() || esperandoOponente;


    private async Task HandleCellClick(int index)
    {
        if (IsCellDisabled(index)) return;

        board[index] = _currentPlayerType;
        string jugador = Simbolo.ToString();

        var response = await movimientosApiService.PostMovimiento(PartidaId, jugador, index / 3, index % 3);
        if (response is Resource<MovimientosResponse>.Error error)
        {
            errorMessage = $"No se pudo registrar movimiento: {error.Message}";
            board[index] = null;
            return;
        }

        errorMessage = null;

        winner = CheckForWinner();
        if (winner != null || (esEmpate = board.All(cell => cell != null)))
        {
            StopAutoRefresh();
        }
        else
        {
            _currentPlayerType = _currentPlayerType == PlayerType.X ? PlayerType.O : PlayerType.X;
        }

        StateHasChanged();
    }

    private PlayerType? CheckForWinner()
    {
        int[][] lines = {
            new[] {0,1,2}, new[] {3,4,5}, new[] {6,7,8},
            new[] {0,3,6}, new[] {1,4,7}, new[] {2,5,8},
            new[] {0,4,8}, new[] {2,4,6}
        };

        foreach (var line in lines)
        {
            if (board[line[0]].HasValue && board[line[0]] == board[line[1]] && board[line[0]] == board[line[2]])
                return board[line[0]];
        }

        return null;
    }

    private string GetPlayerClass(PlayerType? player) => !player.HasValue ? "" : (player == PlayerType.X ? "player-x" : "player-o");

    private void StartAutoRefresh()
    {
        StopAutoRefresh();
        autoRefreshTimer = new Timer(async _ =>
        {
            if (winner == null && !esEmpate)
            {
                await InvokeAsync(async () =>
                {
                    await RefreshGameState();
                    StateHasChanged();
                });
            }
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private void StopAutoRefresh()
    {
        autoRefreshTimer?.Dispose();
        autoRefreshTimer = null;
    }

    private async Task RefreshGameState()
    {
        if (refreshing) return;
        refreshing = true;

        try
        {
            var partidaResponse = await partidasApiServices.GetPartidaAsync(PartidaId);
            if (partidaResponse is Resource<PartidasResponse>.Success partidaSuccess)
            {
                var partida = partidaSuccess.Data;
                if (partida != null)
                {
                    Jugador1Id = partida.Jugador1Id;
                    Jugador2Id = partida.Jugador2Id;
                    if (Jugador2Id.HasValue && Jugador2Id > 0 && esperandoOponente)
                    {
                        esperandoOponente = false;
                        jugador2 = await jugadoresServicios.BuscarId(Jugador2Id.Value);
                    }
                }
            }

            var movimientosResponse = await movimientosApiService.GetMovimientosAsync(PartidaId);
            if (movimientosResponse is Resource<List<MovimientosResponse>>.Success movimientosSuccess)
            {
                board = new PlayerType?[9];
                foreach (var move in movimientosSuccess.Data ?? new List<MovimientosResponse>())
                {
                    int idx = move.PosicionFila * 3 + move.PosicionColumna;
                    if (idx >= 0 && idx < 9)
                        board[idx] = move.Jugador == "X" ? PlayerType.X : PlayerType.O;
                }

                _currentPlayerType = (movimientosSuccess.Data?.Count ?? 0) % 2 == 0 ? PlayerType.X : PlayerType.O;
                winner = CheckForWinner();
                esEmpate = winner == null && board.All(cell => cell != null);

                if (winner != null || esEmpate)
                    StopAutoRefresh();
            }
        }
        catch (ObjectDisposedException) { StopAutoRefresh(); }
        catch (Exception ex) { Console.WriteLine($"Error en RefreshGameState: {ex.Message}"); }
        finally { refreshing = false; }
    }

    private async Task RestartGame()
    {
        board = new PlayerType?[9];
        _currentPlayerType = PlayerType.X;
        winner = null;
        esEmpate = false;
        errorMessage = null;

        StartAutoRefresh();
        StateHasChanged();
    }

    public void Dispose() => StopAutoRefresh();

    public void VolverMenu()
    {
        StopAutoRefresh();
        navigationManager.NavigateTo("/");
    }
}
